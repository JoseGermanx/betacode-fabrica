{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "FABRICA_MARKETPLACE_REPO": "TU_USUARIO/betacode-fabrica"
  },
  "extraKnownMarketplaces": {
    "betacode": {
      "source": {
        "source": "github",
        "repo": "TU_USUARIO/betacode-fabrica"
      }
    }
  },
  "enabledPlugins": {
    "fabrica@betacode": true
  },
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo view:*)",
      "Bash(git:*)",
      "Bash(mkdir -p /home/fabrica/repos/*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(tmux has-session:*)",
      "Bash(tmux new-window:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)"
    ]
  }
}
